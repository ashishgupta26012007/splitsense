# Copy this file to ".env" and fill in your real key.
# Get a FREE key from https://openrouter.ai/keys (no card required to start)
GROQ_API_KEY=your_groq_api_key_here
SECRET_KEY=your_flask_secret_key_here
# Optional. Leave unset to let the app automatically try a built-in list of
# known free models and skip to the next one if any get pulled/retired.
# Set this only if you've found one specific free model you want to force —
# browse current free models (filter by "free") at https://openrouter.ai/models
# OPENROUTER_MODEL=qwen/qwen3-coder:free
